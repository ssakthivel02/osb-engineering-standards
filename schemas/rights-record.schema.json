{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.omsaravanabhava.org/rights-record.schema.json",
  "title": "OSB Rights Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["rightsId", "assetId", "status", "holder", "permissions", "evidence", "reviewedAt"],
  "properties": {
    "rightsId": {"type": "string", "format": "uuid"},
    "assetId": {"type": "string", "minLength": 1},
    "status": {"enum": ["PUBLIC_DOMAIN", "LICENSED", "OSB_OWNED", "RESTRICTED", "UNKNOWN", "EXPIRED"]},
    "holder": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 2},
    "licence": {"type": ["string", "null"]},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display", "download", "modify", "commercialUse", "embedding", "training"],
      "properties": {
        "display": {"type": "boolean"},
        "download": {"type": "boolean"},
        "modify": {"type": "boolean"},
        "commercialUse": {"type": "boolean"},
        "embedding": {"type": "boolean"},
        "training": {"type": "boolean"}
      }
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": ["string", "null"], "format": "date-time"},
    "reviewer": {"type": ["string", "null"]}
  }
}
