{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.omsaravanabhava.org/rights-record.schema.json",
  "title": "OSB Rights Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["rightsId", "status", "jurisdiction", "evidence"],
  "properties": {
    "rightsId": {"type": "string", "minLength": 1},
    "status": {"enum": ["PUBLIC_DOMAIN", "LICENSED", "PERMISSION_REQUIRED", "RESTRICTED", "UNKNOWN"]},
    "jurisdiction": {"type": "string", "minLength": 2},
    "licence": {"type": ["string", "null"]},
    "embeddingPermission": {"enum": ["ALLOWED", "DENIED", "REVIEW_REQUIRED"]},
    "trainingPermission": {"enum": ["ALLOWED", "DENIED", "REVIEW_REQUIRED"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reviewedAt": {"type": ["string", "null"], "format": "date-time"}
  }
}
